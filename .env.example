# Copy to .env (git-ignored) for local development.
#
# Development workspace used by `npm run cli:dev` and by tests (AD-19).
# It must be OUTSIDE this repo, and it must NOT be your real workspace
# (the one `whenkit init` saved in %APPDATA%\whenkit\config.json):
# only code on `main` touches the real catalog.
WHENKIT_WORKSPACE=C:\Users\<you>\Programe\whenkit-dev
